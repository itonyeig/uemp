PORT=4000
NODE_ENV=dev
MONGO_URI=mongodb://127.0.0.1:27017/uemp_api
JWT_SECRET=

# Password for every seeded demo student (npm run seed). At least 15 characters.
DEMO_STUDENT_PASSWORD=DemoStudentPass123!

# Swagger is available only when NODE_ENV=dev. Set both values to sign in.
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin
